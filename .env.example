# SEPscope configuration. Copy to .env and adjust:
#
#   cp .env.example .env
#   docker compose up --build
#
# Every variable any app reads is listed here; each app's tests fail if one is
# missing. Commented-out variables show their default. Under Docker Compose,
# DATABASE_URL, API_URL, API_HOST, API_PORT and the dashboard's PORT/HOSTNAME
# are set by docker-compose.yml for the containers; the values below then only
# matter for running the apps directly (pnpm dev / pnpm start).

# ---------------------------------------------------------------------------
# Shared (worker, API, dashboard)
# ---------------------------------------------------------------------------

# Postgres connection string. Required by the worker and the API.
DATABASE_URL=postgres://sepscope:sepscope@localhost:5432/sepscope

# pino log level: fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info

# After SIGTERM, seconds to let in-flight work finish before exiting anyway
# (worker and API). Keep it below your platform's kill timeout.
SHUTDOWN_TIMEOUT_SECONDS=25

# ---------------------------------------------------------------------------
# Worker (apps/worker)
# ---------------------------------------------------------------------------

# How often each anchor is checked, in minutes.
CHECK_INTERVAL_MINUTES=15

# Path to the anchor registry. Defaults to anchors.json at the repository root
# (the Docker image sets /app/anchors.json).
# ANCHORS_FILE=

# Port and interface for the worker's GET /healthz.
WORKER_HEALTH_PORT=8081
# WORKER_HEALTH_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------

# Port the API listens on. Under Docker Compose, the host port it is published on.
API_PORT=8080
# Interface the API binds to.
# API_HOST=0.0.0.0

# Requests allowed per client IP per minute (/healthz is exempt).
RATE_LIMIT_PER_MINUTE=120

# Behind a reverse proxy, set to true or to the number of proxy hops, so rate
# limits apply per client rather than to the proxy's address.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Dashboard (apps/web)
# ---------------------------------------------------------------------------

# Where the dashboard finds the API. All requests are made server-side.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Overrides NEXT_PUBLIC_API_URL when the server reaches the API at a different
# address, e.g. a Docker service name.
# API_URL=http://api:8080

# Port and interface for `next start` and the standalone server.
# PORT=3000
# HOSTNAME=0.0.0.0

# ---------------------------------------------------------------------------
# Docker Compose only
# ---------------------------------------------------------------------------

# Credentials for the bundled Postgres container. Change the password for any
# shared deployment; DATABASE_URL for the containers is built from these.
POSTGRES_USER=sepscope
POSTGRES_PASSWORD=sepscope
POSTGRES_DB=sepscope

# Host ports. Postgres is published on 127.0.0.1 only, for local tools.
POSTGRES_PORT=5432
WEB_PORT=3000

# ---------------------------------------------------------------------------
# Tests only
# ---------------------------------------------------------------------------

# Set to 1 to also run live tests against testanchor.stellar.org.
# RUN_LIVE_TESTS=1
