# Postgres connection string (required by the worker and the API).
DATABASE_URL=postgres://sepscope:sepscope@localhost:5432/sepscope

# How often each anchor is checked, in minutes.
CHECK_INTERVAL_MINUTES=15

# pino log level: fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info

# Path to the anchor registry. Defaults to anchors.json at the repository root.
# ANCHORS_FILE=

# API.
API_PORT=8080
API_HOST=0.0.0.0
RATE_LIMIT_PER_MINUTE=120
# Set to true, or a number of proxy hops, behind a reverse proxy.
TRUST_PROXY=false

# Dashboard. API_URL overrides NEXT_PUBLIC_API_URL for server-side requests.
# API_URL=http://api:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
